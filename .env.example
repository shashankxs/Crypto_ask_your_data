# MotherDuck token (free at https://motherduck.com) — lets the ingestion job,
# dbt, and the Streamlit app all share one cloud-hosted DuckDB database.
MOTHERDUCK_TOKEN=

# Database name inside MotherDuck
MD_DATABASE=crypto_db

# LLM provider for the text-to-SQL layer: "groq" (default, free, no card) or "anthropic"
LLM_PROVIDER=groq

# Free Groq API key (https://console.groq.com/keys) — no credit card required
GROQ_API_KEY=

# Only needed if LLM_PROVIDER=anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
